  {
    "id": "save-percentage",
    "en": "Save Percentage",
    "ru": "Процент отражений",
    "category": "stat",
    "abbr": [
      "Sv%",
      "SV%"
    ],
    "definition": "Доля бросков в створ, которые вратарь отразил: Sv% = (броски − голы) / броски. В среднем по лиге — около .905–.910, у элитных вратарей — .920 и выше. Сильно зависит от качества бросков, поэтому его смотрят вместе с xGA и GSAx.",
    "ru_slang": null,
    "visual": null,
    "visual_type": null,
    "source": "nhl.com",
    "status": "verified",
    "added": "2026-06-07",
    "notes": "",
